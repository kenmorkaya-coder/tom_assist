{
  "name": "tom-assist",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/extension",
    "apps/desktop/ui",
    "packages/*"
  ],
  "scripts": {
    "schema:generate": "json2ts --cwd crates/protocol/schemas -i crates/protocol/schemas/index.schema.json -o packages/schema-generated/index.ts --bannerComment '/* Generated from crates/protocol/schemas. Do not edit directly. */'",
    "schema:validate": "python3 scripts/validate_protocol_schemas.py",
    "extension:build": "npm run build -w @tom-assist/extension",
    "extension:test": "npm run test -w @tom-assist/extension",
    "adapters:test": "npm run test -w @tom-assist/provider-adapters",
    "desktop:test": "npm run test -w @tom-assist/desktop-ui",
    "desktop:build": "npm run build -w @tom-assist/desktop-ui"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}

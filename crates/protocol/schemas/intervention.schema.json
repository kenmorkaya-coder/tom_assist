{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom-assist.local/schemas/intervention.schema.json",
  "title": "Intervention",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "turn_id", "code", "severity", "confidence", "summary", "response_excerpt", "conflicting_state_ids", "evidence_turn_ids", "status", "policy_version"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "turn_id": {"$ref": "source-id.v1.1.schema.json"},
    "code": {"enum": ["CONTRADICTION", "SUPERSEDED_PATH_REVIVED", "CONSTRAINT_DROPPED", "OBJECTIVE_DRIFT", "COMPLETED_WORK_REPROPOSED", "UNSUPPORTED_STATE_CHANGE", "STALE_EVIDENCE_USED", "WRONG_PROJECT_CONTEXT", "SUPERSESSION_WITHOUT_REASON", "UNRESOLVED_DEPENDENCY_IGNORED", "CONCEPT_DRIFT"]},
    "severity": {"enum": ["info", "warning", "blocking_commit"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string"},
    "response_excerpt": {"type": "string"},
    "conflicting_state_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "evidence_turn_ids": {"type": "array", "items": {"$ref": "source-id.v1.1.schema.json"}},
    "suggested_context_patch": {"type": "string"},
    "status": {"enum": ["open", "accepted", "dismissed", "false_positive", "resolved"]},
    "policy_version": {"type": "string"}
  }
}

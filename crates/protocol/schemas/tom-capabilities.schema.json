{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom-assist.local/schemas/tom-capabilities.schema.json",
  "title": "TomCapabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime_version", "state_format_version", "supports_load_ingest", "supports_branch_activation", "supports_candidate_ranking", "supports_state_snapshot", "supports_commit", "supports_conflict_check", "supports_trajectory_digest", "supports_readonly_ranking", "supports_checkpoint_restore", "supports_nonmutating_load_preview", "engine_parity_profile", "engine_parity_verified_at_commit", "seed_profile", "seed_artifact_sha256", "seed_tick", "seed_branch_count", "mechanics_profile", "mechanics_profile_sha256", "mechanics_parameters", "kappa_decay_source", "commit_dynamics", "front_row_capacity", "teach_on_conflict", "structural_load_mode", "structural_load_compiler_version", "load_evidence_policy", "authoritative_requires_all_17_channels_evidenced", "authoritative_disallowed_zero_kinds", "strict_positive_load_policy", "authoritative_requires_all_17_channels_positive", "semantic_embedding_version", "local_gemma_candidate_required", "model_generated_load_values", "feeling_wheel_used", "supports_documents", "document_chunking_version", "document_embedding_version", "document_max_source_chars", "document_max_chunks", "document_structural_parsing", "document_packet_admission", "supports_document_declared_structure", "document_declared_structure_version", "parser_glossary_enabled", "parser_glossary_version", "parser_glossary_term_count", "parser_glossary_sha256", "parser_glossary_max_terms", "parser_glossary_max_characters"],
  "properties": {
    "commit_dynamics": {"const":["step","rgm_write","leaf_vec_teach","usage_rotation","front_row_reseat"]},
    "front_row_capacity": {"type":"integer","minimum":1},
    "teach_on_conflict": {"type":"boolean"},
    "structural_load_mode": {"enum": ["legacy", "shadow", "authoritative"]},
    "structural_load_compiler_version": {"const": "tom-assist-evidence-load17/1.2"},
    "load_evidence_policy": {"const": "tom-assist-evidenced-load17/1.0"},
    "authoritative_requires_all_17_channels_evidenced": {"const": true},
    "authoritative_disallowed_zero_kinds": {"const": ["clamped_negative"]},
    "strict_positive_load_policy": {"const": "tom-assist-strict-positive-load17/1.0"},
    "authoritative_requires_all_17_channels_positive": {"const": true},
    "semantic_embedding_version": {"const": "minilm-l6-v2/384d-multivector/2.0"},
    "local_gemma_candidate_required": {"type": "boolean"},
    "model_generated_load_values": {"const": false},
    "feeling_wheel_used": {"const": false},
    "supports_documents": {"const": true},
    "document_chunking_version": {"const": "minilm-document-token-sentence-max192-overlap32/1.0"},
    "document_embedding_version": {"const": "minilm-l6-v2/384d-multivector/2.0"},
    "document_max_source_chars": {"const": 2000000},
    "document_max_chunks": {"const": 4096},
    "document_structural_parsing": {"const": false},
    "document_packet_admission": {"const": false},
    "supports_document_declared_structure": {"const": true},
    "document_declared_structure_version": {"const": "tom-assist-declared-structure/1.0"},
    "parser_glossary_enabled": {"type": "boolean"},
    "parser_glossary_version": {"const": "tom-assist-parser-glossary/1.0"},
    "parser_glossary_term_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "parser_glossary_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_glossary_max_terms": {"const": 64},
    "parser_glossary_max_characters": {"const": 2048},
    "preview_channels": {"type":"array","prefixItems":[{"const":"lexical"},{"const":"structural_geometry"}],"minItems":2,"maxItems":2},
    "runtime_version": {"type": "string"},
    "state_format_version": {"const": "sicd-engine-save/1"},
    "supports_load_ingest": {"type": "boolean"},
    "supports_branch_activation": {"type": "boolean"},
    "supports_candidate_ranking": {"type": "boolean"},
    "supports_state_snapshot": {"type": "boolean"},
    "supports_commit": {"type": "boolean"},
    "supports_conflict_check": {"type": "boolean"},
    "supports_trajectory_digest": {"type": "boolean"},
    "supports_readonly_ranking": {"const": true},
    "supports_checkpoint_restore": {"const": true},
    "supports_nonmutating_load_preview": {"const": false},
    "engine_parity_profile": {"type": "string"},
    "engine_parity_verified_at_commit": {"type": "string"},
    "seed_profile": {"const": "msr_8d_native_10k"},
    "seed_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed_tick": {"const": 4707},
    "seed_branch_count": {"const": 10000},
    "mechanics_profile": {"const": "msr_8d_native_10k.env"},
    "mechanics_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mechanics_parameters": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "kappa_decay_source": {"const": "profile_env_reader_wp18_effective_0.03"}
  }
}

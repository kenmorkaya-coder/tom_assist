{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom-assist.local/schemas/error.schema.json",
  "title": "ProtocolError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable", "correlation_id"],
  "properties": {
    "code": {"enum": ["PROTOCOL_MISMATCH", "SERVICE_UNAVAILABLE", "PROJECT_NOT_FOUND", "STATE_VERSION_CONFLICT", "TOM_RUNTIME_UNAVAILABLE", "CAPTURE_INCOMPLETE", "VALIDATION_FAILED", "PERMISSION_DENIED", "DATABASE_INTEGRITY_ERROR", "ADAPTER_UNSUPPORTED"]},
    "message": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "remediation": {"type": "string"},
    "correlation_id": {"type": "string", "format": "uuid"}
  }
}


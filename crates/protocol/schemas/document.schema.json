{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom-assist.local/schemas/document.schema.json",
  "title": "ProjectDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "display_name", "content_sha256", "content", "byte_length", "media_type", "chunking_version", "embedding_version", "ingested_tick", "tombstoned_at", "chunk_count", "chunks", "declared_structure"],
  "properties": {
    "document_id": {"type": "string", "pattern": "^document-[0-9a-f]{32}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content": {"type": "string", "minLength": 1, "maxLength": 2000000},
    "byte_length": {"type": "integer", "minimum": 1},
    "media_type": {"enum": ["text/plain", "text/markdown", "text/x-markdown", "text/html", "text/xml", "application/xml", "application/json"]},
    "chunking_version": {"const": "minilm-document-token-sentence-max192-overlap32/1.0"},
    "embedding_version": {"const": "minilm-l6-v2/384d-multivector/2.0"},
    "ingested_tick": {"type": "integer", "minimum": 0},
    "tombstoned_at": {"type": ["string", "null"], "format": "date-time"},
    "chunk_count": {"type": "integer", "minimum": 1, "maximum": 4096},
    "declared_structure": {
      "anyOf": [
        {"$ref": "declared-structure.schema.json"},
        {"type": "null"}
      ]
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_index", "start", "end", "text_sha256"],
        "properties": {
          "chunk_index": {"type": "integer", "minimum": 0},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}

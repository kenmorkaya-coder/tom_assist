{
  "manifest_version": 3,
  "name": "Tom Assist",
  "version": "0.1.0",
  "description": "Local-first project continuity companion",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "sidePanel"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Tom Assist"
  }
}
